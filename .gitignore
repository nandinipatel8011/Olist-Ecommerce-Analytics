# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# SQLite databases & temp journals
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Archives and compressed files (never commit)
*.zip
*.tar.gz
*.rar
*.7z

# Large Raw and Processed Datasets (keep folder structures via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*.csv
data/processed/powerbi/*.csv
!data/processed/.gitkeep
!data/processed/powerbi/.gitkeep

# Environment variables & secrets
.env
.env.*
secrets.json

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# IDE and Editor configs
.vscode/
.idea/
*.swp
*.swo
